---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getAllSeries, getSeriesByGenre } from '../../utils/series';
import { generateBreadcrumbJsonLd, generateCollectionPageJsonLd } from '../../utils/seo';

export async function getStaticPaths() {
  const series = await getAllSeries();
  const genres = new Set<string>();
  for (const s of series) {
    for (const g of s.data.genre) {
      genres.add(g);
    }
  }
  return [...genres].map((genre) => ({
    params: { slug: genre },
  }));
}

const { slug } = Astro.params;
const allSeries = await getAllSeries();
const genreSeries = getSeriesByGenre(allSeries, slug!);
const genreName = slug!.replace(/-/g, ' ');
const seriesWord = genreSeries.length === 1 ? 'seria' : genreSeries.length < 5 ? 'serie' : 'serii';

const title = `Kolejność czytania: serie ${genreName}`;
const description = `${genreName} — kolejność czytania: ${genreSeries.length} ${seriesWord}. Sprawdź, w jakiej kolejności czytać każdą serię — pełne listy w porządku chronologicznym.`;
const jsonLd = [
  generateCollectionPageJsonLd(
    `Serie ${genreName}`,
    description,
    Astro.site!.href,
    `/gatunki/${slug}`,
    genreSeries.map((s) => ({ name: s.data.title, path: `/${s.id}` }))
  ),
  generateBreadcrumbJsonLd(
    [{ name: 'Strona główna', url: '/' }, { name: 'Gatunki', url: '/gatunki' }, { name: genreName, url: `/gatunki/${slug}` }],
    Astro.site!.href
  ),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ name: 'Strona główna', href: '/' }, { name: 'Gatunki', href: '/gatunki/' }, { name: genreName, href: `/gatunki/${slug}/` }]} />

  <h1 class="text-3xl font-bold mb-2 capitalize">{genreName}</h1>
  <p class="text-lg text-gray-600 mb-8">
    Serie książek z gatunku {genreName} ({genreSeries.length} {genreSeries.length === 1 ? 'seria' : genreSeries.length < 5 ? 'serie' : 'serii'})
  </p>

  <div class="grid gap-3 sm:grid-cols-2">
    {genreSeries.map((s) => (
      <a href={`/${s.id}/`} class="block border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition-colors">
        <h2 class="font-semibold text-blue-700">{s.data.title}</h2>
        <p class="text-sm text-gray-600">{s.data.author}</p>
        <p class="text-sm text-gray-500">{s.data.books.length} {s.data.books.length === 1 ? 'książka' : s.data.books.length < 5 ? 'książki' : 'książek'}</p>
      </a>
    ))}
  </div>
</BaseLayout>

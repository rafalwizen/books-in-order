---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Nie znaleziono strony (404)';
const description = 'Strona, której szukasz, nie istnieje lub została przeniesiona. Wróć na stronę główną albo wyszukaj serię książek.';
---

<BaseLayout title={title} description={description}>
  <div class="text-center py-12">
    <p class="text-6xl font-bold text-gray-300 mb-4">404</p>
    <h1 class="text-3xl font-bold mb-2">Nie znaleziono strony</h1>
    <p class="text-lg text-gray-600 mb-8">
      Strona, której szukasz, nie istnieje lub została przeniesiona.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="px-5 py-3 bg-blue-700 text-white rounded-lg hover:bg-blue-900 transition-colors">
        Strona główna
      </a>
      <a href="/szukaj/" class="px-5 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
        Szukaj serii
      </a>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllSeries, getSeriesByAuthor } from '../../utils/series';

export async function getStaticPaths() {
  const series = await getAllSeries();
  const authors = new Map<string, { name: string; slug: string }>();
  for (const s of series) {
    if (!authors.has(s.data.authorSlug)) {
      authors.set(s.data.authorSlug, { name: s.data.author, slug: s.data.authorSlug });
    }
  }
  return [...authors.entries()].map(([slug, author]) => ({
    params: { slug },
    props: { author },
  }));
}

const { author } = Astro.props;
const { slug } = Astro.params;
const allSeries = await getAllSeries();
const authorSeries = getSeriesByAuthor(allSeries, slug!);

const title = `${author.name} - serie książek`;
const description = `Wszystkie serie książek autora ${author.name}. Sprawdź kolejność czytania.`;
---

<BaseLayout title={title} description={description}>
  <nav class="mb-6 text-sm text-gray-500">
    <ol class="flex flex-wrap items-center gap-1">
      <li class="flex items-center gap-1">
        <a href="/" class="hover:text-gray-700">Strona główna</a>
        <span aria-hidden="true">/</span>
      </li>
      <li>
        <span class="text-gray-900 font-medium">{author.name}</span>
      </li>
    </ol>
  </nav>

  <h1 class="text-3xl font-bold mb-2">{author.name}</h1>
  <p class="text-lg text-gray-600 mb-8">
    Serie książek autora ({authorSeries.length} {authorSeries.length === 1 ? 'seria' : authorSeries.length < 5 ? 'serie' : 'serii'})
  </p>

  <div class="grid gap-3 sm:grid-cols-2">
    {authorSeries.map((s) => (
      <a href={`/${s.id}`} class="block border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition-colors">
        <h2 class="font-semibold text-blue-700">{s.data.title}</h2>
        <p class="text-sm text-gray-500">{s.data.books.length} {s.data.books.length === 1 ? 'książka' : s.data.books.length < 5 ? 'książki' : 'książek'}</p>
      </a>
    ))}
  </div>
</BaseLayout>

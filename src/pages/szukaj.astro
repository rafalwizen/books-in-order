---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Szukaj serii książek"
  description="Wyszukaj serie książek i sprawdź kolejność czytania."
>
  <h1 class="text-3xl font-bold mb-6">Szukaj serii książek</h1>

  <div id="search" class="mb-8"></div>

  <div id="pagefind-search-results"></div>
</BaseLayout>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const searchContainer = document.querySelector('#pagefind-search-results');

    if (searchContainer && typeof window.pagefind !== 'undefined') {
      const params = new URLSearchParams(window.location.search);
      const query = params.get('q') || '';

      if (query) {
        const input = document.querySelector<HTMLInputElement>('#search input');
        if (input) input.value = query;

        window.pagefind.search(query).then((results: any) => {
          results.results.forEach((result: any) => {
            result.data().then((data: any) => {
              const div = document.createElement('div');
              div.className = 'border border-gray-200 rounded-lg p-4 mb-3';
              div.innerHTML = `
                <a href="${data.url}" class="text-blue-700 font-semibold text-lg hover:underline">${data.meta?.title || data.url}</a>
                <p class="text-sm text-gray-600 mt-1">${data.excerpt || ''}</p>
              `;
              searchContainer.appendChild(div);
            });
          });
        });
      }
    }
  });
</script>
